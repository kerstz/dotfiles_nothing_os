{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": ": ",
        "color": {
            "keys": "blue",
            "title": "blue",
            "output": "default"
        },
        "key": {
            "width": 0
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{#4;34}{user-name}@{host-name}{#}"
        },
        {
            "type": "custom",
            "format": "{#34}--{#}"
        },
        { "type": "os", "key": "OS", "format": "{pretty-name} {arch}" },
        { "type": "cpu", "key": "Host", "format": "{name}" },
        { "type": "kernel", "key": "Kernel", "format": "{release}" },
        { "type": "uptime", "key": "Uptime" },
        { "type": "packages", "key": "Packages", "format": "{all} (pacman)" },
        { "type": "shell", "key": "Shell", "format": "{pretty-name} {version}" },
        { "type": "wm", "key": "DE", "format": "{pretty-name} ({protocol-name})" },
        { "type": "custom", "key": "Theme", "format": "Paper-Dots" },
        { "type": "custom", "key": "Icons", "format": "Papericons" },
        { "type": "terminal", "key": "Terminal", "format": "{pretty-name}" },
        { "type": "custom", "key": "Font", "format": "Paper Mono (Handwritten)" },
        "break",
        {
            "type": "custom",
            "key": " ",
            "format": "\u001b[48;2;59;59;59m   \u001b[48;2;56;137;209m   \u001b[48;2;234;125;110m   \u001b[48;2;237;224;198m   \u001b[48;2;111;105;93m   \u001b[48;2;217;85;76m  \u001b[48;2;127;138;144m  \u001b[48;2;159;184;220m  \u001b[48;2;238;224;204m \u001b[48;2;201;189;169m   \u001b[0m"
        }
    ]
}
